{
  "n439": {
    "dynastyId": "southern_northern",
    "title": "北魏统一北方",
    "subtitle": "439 · 十六国终",
    "lede": "拓跋焘三征，凉州入魏。十六国至此终局，北方一统，南北对峙的格局自此定型。",
    "acts": [
      {
        "id": "n439_a1",
        "art": "n439_1",
        "year": "426 — 439 年",
        "heading": "太武三征",
        "lines": [
          "427 年，北魏太武帝拓跋焘攻夏，取统万城。",
          "431 年，夏主赫连定西走，为吐谷浑所擒，夏亡。",
          "436 年，北魏灭北燕；439 年，攻北凉，沮渠牧犍降。"
        ],
        "source": {
          "book": "《魏书·太武帝纪》",
          "text": "平凉州，北方遂一。"
        }
      },
      {
        "id": "n439_a2",
        "art": "n439_2",
        "year": "439 年",
        "heading": "十六国终",
        "lines": [
          "自 304 年刘渊起兵，十六国前后一百三十余年。",
          "439 年北凉降魏，北方最后一个割据政权消失。",
          "北魏据有关中、河北、山东、河西与辽西。"
        ],
        "source": {
          "book": "《魏书·太祖纪》",
          "text": "扫清中土，区宇混一。"
        }
      },
      {
        "id": "n439_a3",
        "art": "n439_3",
        "year": "439 — 450 年",
        "heading": "南北对峙",
        "lines": [
          "北方归北魏，南方为刘宋。",
          "南北以淮、汉为界，长期对峙。",
          "南北朝格局自此定型，直到 589 年隋灭陈。"
        ],
        "source": {
          "book": "《宋书·索虏传》",
          "text": "南北分疆，各守其境。"
        }
      }
    ],
    "enterLabel": "进入 439—479 年",
    "enterHint": "下一段帝王",
    "next": {
      "kind": "timeline",
      "page": 1
    },
    "back": {
      "page": 0
    }
  },
  "n479": {
    "dynastyId": "southern_northern",
    "title": "刘宋灭亡 · 萧齐代之",
    "subtitle": "479 · 宋亡齐立",
    "lede": "宋顺帝禅位于萧道成，刘宋六十年而亡，南朝入齐。",
    "acts": [
      {
        "id": "n479_a1",
        "art": "n479_1",
        "year": "477 — 479 年",
        "heading": "宋末",
        "lines": [
          "后废帝刘昱暴虐，被左右所杀。",
          "萧道成迎立顺帝刘准，独揽朝政。",
          "荆州沈攸之起兵，败死。"
        ],
        "source": {
          "book": "《南齐书·高帝纪》",
          "text": "宋帝禅位，齐台建。"
        }
      },
      {
        "id": "n479_a2",
        "art": "n479_2",
        "year": "479 年",
        "heading": "禅让",
        "lines": [
          "昇明三年，顺帝下诏禅位。",
          "萧道成即皇帝位，国号齐，改元建元。",
          "刘宋八帝，凡六十年而亡。"
        ],
        "source": {
          "book": "《南齐书·高帝纪》",
          "text": "即皇帝位，国号齐，改元建元。"
        }
      },
      {
        "id": "n479_a3",
        "art": "n479_3",
        "year": "479 — 482 年",
        "heading": "余波",
        "lines": [
          "宋宗室多遭诛杀。",
          "齐初以宽简为政，不久亦陷入宗室相残。",
          "南朝易代，自此进入“禅让—屠宗”的循环。"
        ],
        "source": {
          "book": "《南史·宋本纪》",
          "text": "宋室诸王，诛夷略尽。"
        }
      }
    ],
    "enterLabel": "进入 479—502 年",
    "enterHint": "下一段帝王",
    "next": {
      "kind": "timeline",
      "page": 2
    },
    "back": {
      "page": 1
    }
  },
  "n502": {
    "dynastyId": "southern_northern",
    "title": "萧齐灭亡 · 萧梁代之",
    "subtitle": "502 · 齐亡梁立",
    "lede": "齐和帝禅位于萧衍，萧齐二十三年而亡，梁武帝开天监之治。",
    "acts": [
      {
        "id": "n502_a1",
        "art": "n502_1",
        "year": "501 — 502 年",
        "heading": "齐末",
        "lines": [
          "东昏侯萧宝卷诛戮大臣，政刑混乱。",
          "萧衍自襄阳起兵，拥立和帝萧宝融。",
          "建康陷，东昏侯被杀。"
        ],
        "source": {
          "book": "《梁书·武帝纪》",
          "text": "义师克建康，东昏侯伏诛。"
        }
      },
      {
        "id": "n502_a2",
        "art": "n502_2",
        "year": "502 年",
        "heading": "禅让",
        "lines": [
          "天监元年，和帝禅位于萧衍。",
          "萧衍即皇帝位，国号梁。",
          "齐七帝，凡二十四年。"
        ],
        "source": {
          "book": "《梁书·武帝纪》",
          "text": "齐帝禅位，梁台建。"
        }
      },
      {
        "id": "n502_a3",
        "art": "n502_3",
        "year": "502 — 520 年",
        "heading": "梁初",
        "lines": [
          "梁武帝在位四十八年，为南朝最长。",
          "天监之治，文教称盛。",
          "晚年侯景之乱，梁室由盛转衰。"
        ],
        "source": {
          "book": "《梁书·武帝纪》",
          "text": "天监之治，民物阜康。"
        }
      }
    ],
    "enterLabel": "进入 502—534 年",
    "enterHint": "下一段帝王",
    "next": {
      "kind": "timeline",
      "page": 3
    },
    "back": {
      "page": 2
    }
  },
  "n534": {
    "dynastyId": "southern_northern",
    "title": "北魏分裂",
    "subtitle": "534 · 魏分东西",
    "lede": "孝武帝西奔长安，高欢另立东魏，北魏一分为二。",
    "acts": [
      {
        "id": "n534_a1",
        "art": "n534_1",
        "year": "528 — 534 年",
        "heading": "乱源",
        "lines": [
          "六镇之乱后，尔朱荣入洛，河阴之变诛杀朝士。",
          "高欢起兵灭尔朱氏，拥立孝武帝。",
          "帝不堪高欢专权，西奔关中依宇文泰。"
        ],
        "source": {
          "book": "《魏书·孝武帝纪》",
          "text": "帝西幸长安，依宇文泰。"
        }
      },
      {
        "id": "n534_a2",
        "art": "n534_2",
        "year": "534 年",
        "heading": "分裂",
        "lines": [
          "高欢另立元善见为帝，迁都邺，是为东魏。",
          "宇文泰在长安奉元宝炬为帝，是为西魏。",
          "北魏自此分裂，东西对峙。"
        ],
        "source": {
          "book": "《北史·魏本纪》",
          "text": "自是魏分为二。"
        }
      },
      {
        "id": "n534_a3",
        "art": "n534_3",
        "year": "534 — 550 年",
        "heading": "影响",
        "lines": [
          "东魏、西魏皆由权臣掌握。",
          "高氏、宇文氏各自积蓄力量，等候取而代之。",
          "北方进入东魏—北齐、西魏—北周两条线。"
        ],
        "source": {
          "book": "《资治通鉴》梁纪",
          "text": "东西魏分据，兵连祸结。"
        }
      }
    ],
    "enterLabel": "进入 534—550 年",
    "enterHint": "下一段帝王",
    "next": {
      "kind": "timeline",
      "page": 4
    },
    "back": {
      "page": 3
    }
  },
  "n550": {
    "dynastyId": "southern_northern",
    "title": "东魏灭亡 · 北齐代之",
    "subtitle": "550 · 东魏亡，北齐立",
    "lede": "高洋受禅于东魏，国号齐。北齐代东魏，与西魏·北周隔河对峙。",
    "acts": [
      {
        "id": "n550_a1",
        "art": "n550_1",
        "year": "547 — 550 年",
        "heading": "高氏专权",
        "lines": [
          "高欢死后，高澄继掌东魏。",
          "高澄遇刺，高洋接掌军政。",
          "孝静帝完全沦为傀儡。"
        ],
        "source": {
          "book": "《北齐书·文宣帝纪》",
          "text": "帝受禅于魏，国号齐。"
        }
      },
      {
        "id": "n550_a2",
        "art": "n550_2",
        "year": "550 年",
        "heading": "受禅",
        "lines": [
          "武定八年，孝静帝禅位。",
          "高洋即皇帝位，国号齐，史称北齐。",
          "东魏十七年而亡。"
        ],
        "source": {
          "book": "《北齐书·文宣帝纪》",
          "text": "即皇帝位，改元天保。"
        }
      },
      {
        "id": "n550_a3",
        "art": "n550_3",
        "year": "550 — 577 年",
        "heading": "北齐",
        "lines": [
          "北齐据河北、山东、河南，国力一度强于北周。",
          "后期君主多昏暴，国势渐衰。",
          "577 年为北周所灭。"
        ],
        "source": {
          "book": "《北齐书·后主纪》",
          "text": "政出多门，国用耗竭。"
        }
      }
    ],
    "enterLabel": "进入 550—557 年",
    "enterHint": "下一段帝王",
    "next": {
      "kind": "timeline",
      "page": 5
    },
    "back": {
      "page": 4
    }
  },
  "n557": {
    "dynastyId": "southern_northern",
    "title": "梁亡陈立 · 周代西魏",
    "subtitle": "557 · 梁亡陈立，周代西魏",
    "lede": "侯景乱后梁室倾覆：陈霸先代梁建陈，宇文氏代西魏建周，南北同年易代。",
    "acts": [
      {
        "id": "n557_a1",
        "art": "n557_1",
        "year": "548 — 552 年",
        "heading": "侯景之乱",
        "lines": [
          "548 年侯景自寿阳起兵，渡江围建康。",
          "549 年台城陷，梁武帝饿死。",
          "江南残破，梁室诸王互相攻杀。"
        ],
        "source": {
          "book": "《梁书·侯景传》",
          "text": "景攻陷台城，武帝崩于净居殿。"
        }
      },
      {
        "id": "n557_a2",
        "art": "n557_2",
        "year": "552 — 557 年",
        "heading": "梁末",
        "lines": [
          "元帝萧绎平侯景，都江陵。",
          "554 年西魏攻陷江陵，元帝被杀。",
          "陈霸先、王僧辩拥立敬帝，后陈霸先袭杀王僧辩。"
        ],
        "source": {
          "book": "《陈书·高祖纪》",
          "text": "高祖讨平侯景，迎立敬帝。"
        }
      },
      {
        "id": "n557_a3",
        "art": "n557_3",
        "year": "557 年",
        "heading": "陈、周并立",
        "lines": [
          "557 年，梁敬帝禅位于陈霸先，陈立。",
          "同年，宇文觉受西魏禅，北周立。",
          "南朝陈据江南；北周据关中、巴蜀，北方双雄并立。"
        ],
        "source": {
          "book": "《陈书·高祖纪》",
          "text": "梁帝禅位，陈台建。"
        }
      }
    ],
    "enterLabel": "进入 557—577 年",
    "enterHint": "下一段帝王",
    "next": {
      "kind": "timeline",
      "page": 6
    },
    "back": {
