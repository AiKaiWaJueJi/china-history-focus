    }
  },
  "n577": {
    "dynastyId": "southern_northern",
    "title": "北周灭北齐",
    "subtitle": "577 · 周灭北齐",
    "lede": "周武帝亲征，克晋阳、邺城，北齐亡。北方复归一统。",
    "acts": [
      {
        "id": "n577_a1",
        "art": "n577_1",
        "year": "565 — 576 年",
        "heading": "齐政日坏",
        "lines": [
          "北齐后主高纬宠信冯小怜、和士开。",
          "诛杀斛律光等名将，自毁长城。",
          "赋役繁重，民不聊生。"
        ],
        "source": {
          "book": "《北齐书·后主纪》",
          "text": "盛修宫苑，穷极奢丽。"
        }
      },
      {
        "id": "n577_a2",
        "art": "n577_2",
        "year": "575 — 577 年",
        "heading": "周武伐齐",
        "lines": [
          "575 年，周武帝宇文邕亲征北齐。",
          "576 年取平阳，577 年克晋阳。",
          "齐后主弃邺东逃，被俘。"
        ],
        "source": {
          "book": "《周书·武帝纪》",
          "text": "帝亲率六军，东伐齐。"
        }
      },
      {
        "id": "n577_a3",
        "art": "n577_3",
        "year": "577 年",
        "heading": "北方一统",
        "lines": [
          "北齐亡，北周尽有北方。",
          "周武帝灭佛、整军，国力大盛。",
          "为隋代周、统一南北奠定基础。"
        ],
        "source": {
          "book": "《周书·武帝纪》",
          "text": "齐平，北方遂一。"
        }
      }
    ],
    "enterLabel": "进入 577—589 年",
    "enterHint": "下一段帝王",
    "next": {
      "kind": "timeline",
      "page": 7
    },
    "back": {
      "page": 6
    }
  },
  "n589": {
    "dynastyId": "southern_northern",
    "title": "隋灭陈 · 南北朝终",
    "subtitle": "589 · 隋灭陈",
    "lede": "隋军渡江，建康陷落，陈后主出降。自永嘉以来近三百年的分裂至此终结。",
    "acts": [
      {
        "id": "n589_a1",
        "art": "n589_1",
        "year": "581 年",
        "heading": "隋代周",
        "lines": [
          "581 年，杨坚受北周禅，国号隋。",
          "隋文帝整顿户籍、府兵，国力强盛。",
          "587 年灭后梁，控制江陵。"
        ],
        "source": {
          "book": "《隋书·高祖纪》",
          "text": "受周禅，国号隋，改元开皇。"
        }
      },
      {
        "id": "n589_a2",
        "art": "n589_2",
        "year": "588 — 589 年",
        "heading": "伐陈",
        "lines": [
          "588 年，隋以杨广、杨素、韩擒虎、贺若弼分道伐陈。",
          "589 年正月，贺若弼渡江取京口，韩擒虎取采石。",
          "建康陷，陈后主与张丽华藏于井中被俘。"
        ],
        "source": {
          "book": "《隋书·高祖纪》",
          "text": "开皇九年，平陈，天下为一。"
        }
      },
      {
        "id": "n589_a3",
        "art": "n589_3",
        "year": "589 年",
        "heading": "统一",
        "lines": [
          "陈亡，南朝一百七十年终结。",
          "自西晋末年以来近三百年的分裂结束。",
          "南北朝之后，进入隋唐大一统。"
        ],
        "source": {
          "book": "《隋书·高祖纪》",
          "text": "九州大同，区宇宁一。"
        }
      }
    ],
    "enterLabel": "进入收尾沙盘 · 隋灭陈",
    "enterHint": "隋灭陈",
