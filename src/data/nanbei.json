  "nodes": [
    {
      "id": "n479",
      "year": 479,
      "title": "刘宋灭亡 · 萧齐代之",
      "subtitle": "宋顺帝禅位于萧道成",
      "acts": [
        {
          "heading": "宋末",
          "lines": [
            "后废帝刘昱暴虐，被左右所杀。",
            "萧道成迎立顺帝刘准，独揽朝政。",
            "荆州沈攸之起兵，败死。"
          ],
          "source": {
            "book": "《南齐书·高帝纪》",
            "text": "宋帝禅位，齐台建。"
          }
        },
        {
          "heading": "禅让",
          "lines": [
            "昇明三年，顺帝下诏禅位。",
            "萧道成即皇帝位，国号齐，改元建元。",
            "刘宋八帝，凡六十年而亡。"
          ],
          "source": {
            "book": "《南齐书·高帝纪》",
            "text": "即皇帝位，国号齐，改元建元。"
          }
        },
        {
          "heading": "余波",
          "lines": [
            "宋宗室多遭诛杀。",
            "齐初以宽简为政，不久亦陷入宗室相残。",
            "南朝易代，自此进入“禅让—屠宗”的循环。"
          ],
          "source": {
            "book": "《南史·宋本纪》",
            "text": "宋室诸王，诛夷略尽。"
          }
        }
      ]
    },
    {
      "id": "n502",
      "year": 502,
      "title": "萧齐灭亡 · 萧梁代之",
      "subtitle": "齐和帝禅位于萧衍",
      "acts": [
        {
          "heading": "齐末",
          "lines": [
            "东昏侯萧宝卷诛戮大臣，政刑混乱。",
            "萧衍自襄阳起兵，拥立和帝萧宝融。",
            "建康陷，东昏侯被杀。"
          ],
          "source": {
            "book": "《梁书·武帝纪》",
            "text": "义师克建康，东昏侯伏诛。"
          }
        },
        {
          "heading": "禅让",
          "lines": [
            "天监元年，和帝禅位于萧衍。",
            "萧衍即皇帝位，国号梁。",
            "齐七帝，凡二十四年。"
          ],
          "source": {
            "book": "《梁书·武帝纪》",
            "text": "齐帝禅位，梁台建。"
          }
        },
        {
          "heading": "梁初",
          "lines": [
            "梁武帝在位四十八年，为南朝最长。",
            "天监之治，文教称盛。",
            "晚年侯景之乱，梁室由盛转衰。"
          ],
          "source": {
            "book": "《梁书·武帝纪》",
            "text": "天监之治，民物阜康。"
          }
        }
      ]
    },
    {
      "id": "n534",
      "year": 534,
      "title": "北魏分裂",
      "subtitle": "孝武帝西奔，东魏、西魏并立",
      "acts": [
        {
          "heading": "乱源",
          "lines": [
            "六镇之乱后，尔朱荣入洛，河阴之变诛杀朝士。",
            "高欢起兵灭尔朱氏，拥立孝武帝。",
            "帝不堪高欢专权，西奔关中依宇文泰。"
          ],
          "source": {
            "book": "《魏书·孝武帝纪》",
            "text": "帝西幸长安，依宇文泰。"
          }
        },
        {
          "heading": "分裂",
          "lines": [
            "高欢另立元善见为帝，迁都邺，是为东魏。",
            "宇文泰在长安奉元宝炬为帝，是为西魏。",
            "北魏自此分裂，东西对峙。"
          ],
          "source": {
            "book": "《北史·魏本纪》",
            "text": "自是魏分为二。"
          }
        },
        {
          "heading": "影响",
          "lines": [
            "东魏、西魏皆由权臣掌握。",
            "高氏、宇文氏各自积蓄力量，等候取而代之。",
            "北方进入东魏—北齐、西魏—北周两条线。"
          ],
          "source": {
            "book": "《资治通鉴》梁纪",
            "text": "东西魏分据，兵连祸结。"
          }
        }
      ]
    },
    {
      "id": "n550",
      "year": 550,
      "title": "东魏灭亡 · 北齐代之",
      "subtitle": "高洋受禅，国号齐",
      "acts": [
        {
          "heading": "高氏专权",
          "lines": [
            "高欢死后，高澄继掌东魏。",
            "高澄遇刺，高洋接掌军政。",
            "孝静帝完全沦为傀儡。"
          ],
          "source": {
            "book": "《北齐书·文宣帝纪》",
            "text": "帝受禅于魏，国号齐。"
          }
        },
        {
          "heading": "受禅",
          "lines": [
            "武定八年，孝静帝禅位。",
            "高洋即皇帝位，国号齐，史称北齐。",
            "东魏十七年而亡。"
          ],
          "source": {
            "book": "《北齐书·文宣帝纪》",
            "text": "即皇帝位，改元天保。"
          }
        },
        {
          "heading": "北齐",
          "lines": [
            "北齐据河北、山东、河南，国力一度强于北周。",
            "后期君主多昏暴，国势渐衰。",
            "577 年为北周所灭。"
          ],
          "source": {
            "book": "《北齐书·后主纪》",
            "text": "政出多门，国用耗竭。"
          }
        }
      ]
    },
    {
      "id": "n557",
      "year": 557,
      "title": "梁亡陈立 · 周代西魏",
      "subtitle": "南朝陈与北朝周同年而立",
      "acts": [
        {
          "heading": "侯景之乱",
          "lines": [
            "548 年侯景自寿阳起兵，渡江围建康。",
            "549 年台城陷，梁武帝饿死。",
            "江南残破，梁室诸王互相攻杀。"
          ],
          "source": {
            "book": "《梁书·侯景传》",
            "text": "景攻陷台城，武帝崩于净居殿。"
          }
        },
        {
          "heading": "梁末",
          "lines": [
            "元帝萧绎平侯景，都江陵。",
            "554 年西魏攻陷江陵，元帝被杀。",
            "陈霸先、王僧辩拥立敬帝，后陈霸先袭杀王僧辩。"
          ],
          "source": {
            "book": "《陈书·高祖纪》",
            "text": "高祖讨平侯景，迎立敬帝。"
          }
        },
        {
          "heading": "陈、周并立",
          "lines": [
            "557 年，梁敬帝禅位于陈霸先，陈立。",
            "同年，宇文觉受西魏禅，北周立。",
            "南朝陈据江南；北周据关中、巴蜀，北方双雄并立。"
          ],
          "source": {
            "book": "《陈书·高祖纪》",
            "text": "梁帝禅位，陈台建。"
          }
        }
      ]
    },
    {
      "id": "n577",
      "year": 577,
      "title": "北周灭北齐",
      "subtitle": "周武帝统一北方",
      "acts": [
        {
          "heading": "齐政日坏",
          "lines": [
            "北齐后主高纬宠信冯小怜、和士开。",
            "诛杀斛律光等名将，自毁长城。",
            "赋役繁重，民不聊生。"
          ],
          "source": {
            "book": "《北齐书·后主纪》",
            "text": "盛修宫苑，穷极奢丽。"
          }
